---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
import photo from '../assets/coast-drive.jpg';

// The opening line lives in site.ts so the bio, meta description, and share
// image all stay in sync.
const intro = site.tagline;

const affiliations = [
  { org: 'Reflex', role: 'Head of Growth', href: 'https://reflex.dev', note: '(current)' },
  { org: 'Dedalus Labs', role: 'Head of Growth' },
  { org: 'Bloom', role: 'Co-founder, CTO' },
  { org: 'Neev Data', role: 'SWE intern, GTM' },
] as {
  org: string;
  role: string;
  href?: string;
  note?: string;
}[];

const education = { org: 'Northeastern', role: "'27 (On leave)" };

// Explicit display text so long URLs (Spotify) stay readable in the column.
const contacts = [
  { label: 'Email', value: site.links.email, href: `mailto:${site.links.email}` },
  { label: 'X', value: 'x.com/palashaw_', href: site.links.x },
  { label: 'LinkedIn', value: 'linkedin.com/in/palash-awasthi', href: site.links.linkedin },
  { label: 'Spotify', value: 'open.spotify.com', href: site.links.spotify },
];
---

<BaseLayout title={site.name} description={intro}>
  <div class="shell">
    <figure class="shell__figure" data-reveal>
      <Image
        src={photo}
        alt="A white Porsche convertible parked on a coastal road at sunset, ocean and clouded sky beyond the guardrail."
        widths={[480, 800, 1200]}
        sizes="(max-width: 880px) 100vw, 42vw"
        class="shell__photo"
        loading="eager"
      />
    </figure>

    <div class="shell__content">
      <h1 class="display shell__name" data-reveal>{site.name}</h1>

      <div class="bio" data-reveal data-reveal-group="bio">
        <p>{intro}</p>
        <p>
          I believe strongly in precedent; I try to ground my decisions in the
          past.
        </p>
        <p>
          I like cars a lot! If you're in the bay and would like to go on a drive
          together, reach out to me.
        </p>
      </div>

      <section class="block" data-reveal data-reveal-group="bio" aria-labelledby="affiliations">
        <h2 id="affiliations" class="eyebrow">Affiliations</h2>
        <dl class="pairs">
          {
            affiliations.map((a) => (
              <div class="pairs__row">
                <dt class="meta pairs__key">
                  {a.href ? (
                    <a class="pairs__orglink" href={a.href} rel="noopener">
                      {a.org}
                    </a>
                  ) : (
                    a.org
                  )}
                  {a.note && <span class="pairs__note">{` ${a.note}`}</span>}
                </dt>
                <dd class="pairs__val">{a.role}</dd>
              </div>
            ))
          }
          <div class="pairs__row pairs__row--sep">
            <dt class="meta pairs__key">{education.org}</dt>
            <dd class="pairs__val">{education.role}</dd>
          </div>
        </dl>
      </section>

      <section class="block" data-reveal data-reveal-group="bio" aria-labelledby="elsewhere">
        <h2 id="elsewhere" class="eyebrow">Elsewhere</h2>
        <dl class="pairs">
          {
            contacts.map((c) => (
              <div class="pairs__row">
                <dt class="meta pairs__key">{c.label}</dt>
                <dd class="pairs__val">
                  <a
                    class="pairs__link"
                    href={c.href}
                    rel={c.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    {c.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Photo left, content right — everything in the content column is
     right-aligned against the page's right edge. */
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .shell__figure { margin: 0; }
  .shell__photo {
    width: 100%;
    height: auto;
    display: block;
  }

  .shell__content {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .shell__name { margin-bottom: 1.5rem; }

  .bio {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 46ch;
  }
  .bio > * + * { margin-top: 1.1em; }

  .block { margin-top: 2.6rem; width: 100%; }
  .block .eyebrow { display: block; margin-bottom: 1.1rem; }

  /* Two columns that share alignment across every row (rows are
     display:contents), hugging the left edge. */
  .pairs {
    display: grid;
    grid-template-columns: max-content max-content;
    justify-content: start;
    /* Mono label and sans value differ in size — align their baselines. */
    align-items: baseline;
    column-gap: 2rem;
    row-gap: 0.8rem;
  }
  .pairs__row { display: contents; }

  .pairs__key {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.95rem;
    color: var(--ink-muted);
    text-align: left;
  }
  .pairs__val {
    font-size: 1.0625rem;
    color: var(--ink);
    text-align: left;
  }

  .pairs__note {
    white-space: pre;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .pairs__orglink,
  .pairs__link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    transition: color 140ms ease, text-decoration-color 140ms ease;
  }
  .pairs__orglink:hover,
  .pairs__link:hover {
    color: var(--accent-hover);
    text-decoration-color: currentColor;
  }
  .pairs__link {
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }

  /* The school sits slightly apart from the roles. */
  .pairs__row--sep > dt,
  .pairs__row--sep > dd { margin-top: 0.9rem; }

  /* Stack: photo first, content below, still right-aligned. */
  @media (max-width: 880px) {
    .shell { grid-template-columns: 1fr; }
    .shell__figure { max-width: 30rem; }
  }

  @media (max-width: 460px) {
    .pairs {
      grid-template-columns: 1fr;
      row-gap: 0.15rem;
    }
    .pairs__row + .pairs__row > dt { margin-top: 0.8rem; }
    .pairs__row--sep > dt { margin-top: 1.4rem; }
    .pairs__row--sep > dd { margin-top: 0; }
  }
</style>

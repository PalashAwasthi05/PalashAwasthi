---
import { site } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative path to a per-page OG image. */
  ogImage?: string;
  /** og:type — "website" for index pages, "article" for posts. */
  type?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  ogImage = '/og/default.png',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

{/* Flag JS availability before paint so scroll-reveal can hide-then-reveal
    without a flash. With JS off, [data-reveal] content stays visible. */}
<script is:inline>document.documentElement.classList.add('js');</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Preload the two above-the-fold faces — body 400 and heading 600 — copied to
    /fonts at build. ~10KB each. */}
<link rel="preload" href="/fonts/akatab-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/akatab-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

{/* Light-only site. */}
<meta name="theme-color" content="#FFFFFF" />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={site.name} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

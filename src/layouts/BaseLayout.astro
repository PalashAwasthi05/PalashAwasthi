---
// Self-hosted fonts (Fontsource). Akatab for display/headings/body — latin
// subset, only the three weights the design uses (400 body, 500 h2/rows,
// 600 display/h1/h3/strong). Geist Mono for metadata, dates, and code.
import '@fontsource/akatab/latin-400.css';
import '@fontsource/akatab/latin-500.css';
import '@fontsource/akatab/latin-600.css';
import '@fontsource-variable/geist-mono/wght.css';

import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import RevealScript from '../components/RevealScript.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const { title, description, ogImage, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} type={type} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main" class="container site-main">
      <slot />
    </main>
    <RevealScript />
  </body>
</html>

<style>
  .site-main {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    min-height: 60vh;
  }
</style>
